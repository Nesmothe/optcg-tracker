VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Leader search (CROCO) note: CROCO_API_URL is NOT set here. It's a
# server-only variable set directly in Vercel's dashboard (Project Settings
# → Environment Variables) — see the README for the leader-search setup
# steps. It only powers the serverless proxy in /api/croco, so it isn't
# needed for local `npm run dev` at all.
